<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1E9"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="dashguard"
        android:textColor="#202821"
        android:textSize="25sp"
        android:textStyle="bold"
        android:letterSpacing="-0.03" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="12dp"
        android:text="READY · DETECTOR NOT RUNNING"
        android:textColor="#667561"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.09" />

    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#17221D">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <com.atharv.dashguard.DetectionOverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/cameraPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◎"
                android:textColor="#DDE8D6"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Road camera is off"
                android:textColor="#F5F3EA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Start detection to open the rear camera and run the model on this device."
                android:textColor="#B3C0B5"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/objectCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 relevant objects"
            android:textColor="#26342A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inferenceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— ms"
            android:textColor="#6E7B6D"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/toggleDetectionButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#26362B"
        android:text="START DETECTION"
        android:textColor="#F6F4EC"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="ON-DEVICE OBJECT DETECTION · NO DISTANCE ESTIMATE · NOT A DRIVING SAFETY SYSTEM"
        android:textColor="#92988D"
        android:textSize="8sp"
        android:letterSpacing="0.05" />

</LinearLayout>
